flowchart LR
    TIME["🕒 Required date & time"]
    MAIN["⏱ Main"]
    MENU["☰ Menu"]
    STATS["▥ Statistics"]
    SETTINGS["⚙ Settings"]
    STEPPER["↕ Numeric editor"]
    COMPLETE["✓ Completion Transition"]
    ABORT{"End active Timer?"}
    RESET{"Reset Timer?"}
    CLEAR{"Clear Set Progress?"}

    TIME -->|"Confirm first setup"| MAIN
    MAIN -->|"Timer reaches 00:00"| COMPLETE
    COMPLETE -->|"Start now, auto-start, or cancel"| MAIN

    MAIN -->|"Menu"| MENU
    MENU -->|"Back"| MAIN
    MENU --> STATS
    STATS -->|"Back"| MENU
    MENU --> SETTINGS
    SETTINGS -->|"Back"| MENU

    SETTINGS -->|"Duration or Daily Goal"| STEPPER
    STEPPER -->|"Confirm or Back"| SETTINGS
    SETTINGS -->|"Date & time"| TIME
    TIME -->|"Confirm or Back from Settings"| SETTINGS

    MENU -->|"Clear Set Progress"| CLEAR
    CLEAR -->|"Confirm"| MAIN
    CLEAR -->|"Cancel"| MENU

    MAIN -->|"Change Mode while active"| ABORT
    ABORT -->|"Confirm or Cancel"| MAIN
    MAIN -->|"Reset unfinished Timer"| RESET
    RESET -->|"Confirm or Cancel"| MAIN

    classDef page fill:#D8EAFE,stroke:#245A8D,stroke-width:2px,color:#102A43
    classDef setup fill:#E6E0F8,stroke:#6347A0,stroke-width:2px,color:#2D1F4E
    classDef state fill:#DDF4E4,stroke:#287A43,stroke-width:2px,color:#123B21
    classDef decision fill:#FFE2E2,stroke:#A83A3A,stroke-width:2px,color:#4A1111

    class MAIN,MENU,STATS,SETTINGS,STEPPER page
