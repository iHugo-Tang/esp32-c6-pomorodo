{
  "description": "Report Codex Workspace lifecycle status to the Pomodoro broker.",
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/hook.mjs\"", "timeout": 2}]}],
    "SessionEnd": [{"hooks": [{"type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/hook.mjs\"", "timeout": 3}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/hook.mjs\"", "timeout": 2, "additionalContextLimit": 100}]}],
    "PermissionRequest": [{"hooks": [{"type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/hook.mjs\"", "timeout": 2}]}],
    "PreToolUse": [{"hooks": [{"type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/hook.mjs\"", "timeout": 2}]}],
    "PostToolUse": [{"hooks": [{"type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/hook.mjs\"", "timeout": 2}]}],
    "SubagentStart": [{"hooks": [{"type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/hook.mjs\"", "timeout": 2}]}],
    "SubagentStop": [{"hooks": [{"type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/hook.mjs\"", "timeout": 2}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/hook.mjs\"", "timeout": 2}]}]
  }
}
